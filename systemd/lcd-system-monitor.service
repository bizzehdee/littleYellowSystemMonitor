[Unit]
Description=LCD System Monitor Service
After=network.target

[Service]
ExecStart=/usr/local/bin/lcd-system-monitor.py
Restart=always
RestartSec=5
User=root
Group=root
Environment=PYTHONUNBUFFERED=1
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=lcd-system-monitor

[Install]
WantedBy=multi-user.target
